{
  "name": "coinwallet",
  "private": true,
  "version": "6.33.0",
  "description": "Coin Wallet",
  "bugs": {
    "url": "https://github.com/CoinSpace/CoinSpace/issues"
  },
  "license": "MIT",
  "author": "Coin Wallet <support@coin.space> (https://coin.space/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoinSpace/CoinSpace.git"
  },
  "type": "module",
  "scripts": {
    "postinstall": "patch-package",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --outDir ../server/dist",
    "i18n:extract": "vue-i18n-extract report --add --remove --noEmptyTranslation='en' --separator=🍩 --vueFiles '{./src/**/*.?(js|vue),../phonegap/lib/**/*.js}' --languageFiles './src/lib/i18n/messages/*.json' && jsonsort './src/lib/i18n/messages/*.json'",
    "i18n:ci": "node support/i18n.js check && vue-i18n-extract report --ci --vueFiles \"{./src/**/*.?(js|vue),../phonegap/lib/**/*.js}\" --languageFiles \"./src/lib/i18n/messages/*.json\"",
    "i18n:count": "node support/i18n.js count",
    "schemes": "node support/schemes.js",
    "svgo": "svgo --config svgo.config.js --folder src/assets/svg",
    "lint": "eslint . --ext .vue,.js --report-unused-disable-directives",
    "lint:style": "stylelint '**/*.{vue,scss}'"
  },
  "dependencies": {
    "@coinspace/cs-bitcoin-wallet": "github:CoinSpace/cs-bitcoin-wallet",
    "@coinspace/cs-cardano-wallet": "github:CoinSpace/cs-cardano-wallet",
    "@coinspace/cs-common": "github:CoinSpace/cs-common",
    "@coinspace/cs-eos-wallet": "github:CoinSpace/cs-eos-wallet",
    "@coinspace/cs-evm-wallet": "github:CoinSpace/cs-evm-wallet",
    "@coinspace/cs-kaspa-wallet": "github:CoinSpace/cs-kaspa-wallet",
    "@coinspace/cs-monero-wallet": "github:CoinSpace/cs-monero-wallet",
    "@coinspace/cs-ripple-wallet": "github:CoinSpace/cs-ripple-wallet",
    "@coinspace/cs-solana-wallet": "github:CoinSpace/cs-solana-wallet",
    "@coinspace/cs-stellar-wallet": "github:CoinSpace/cs-stellar-wallet",
    "@coinspace/cs-sui-wallet": "github:CoinSpace/cs-sui-wallet",
    "@coinspace/cs-toncoin-wallet": "github:CoinSpace/cs-toncoin-wallet",
    "@coinspace/cs-tron-wallet": "github:CoinSpace/cs-tron-wallet",
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "1.9.1",
    "@noble/hashes": "^1.8.0",
    "@scure/base": "^1.2.5",
    "@scure/bip39": "^1.6.0",
    "@sentry/vue": "^10.8.0",
    "@simplewebauthn/browser": "^8.3.1",
    "@suchipi/femver": "^1.0.0",
    "@ton/core": "^0.62.0",
    "@ton/crypto": "^3.2.0",
    "apexcharts": "^4.5.0",
    "axios": "^1.4.0",
    "axios-retry": "^3.5.0",
    "country-list": "^2.3.0",
    "events": "^3.3.0",
    "expiry-map": "^2.0.0",
    "fast-json-stable-stringify": "^2.1.0",
    "fuse.js": "^6.6.2",
    "jdenticon": "^3.2.0",
    "libphonenumber-js": "^1.13.10",
    "p-debounce": "^4.0.0",
    "p-memoize": "^7.1.1",
    "patch-package": "^8.0.0",
    "qrcode-svg": "^1.1.0",
    "vue": "^3.2.37",
    "vue-i18n": "^9.2.2",
    "vue-router": "^4.1.2",
    "vue3-apexcharts": "^1.8.0"
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^2.0.0",
    "@sentry/vite-plugin": "^4.2.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-vue": "^4.0.0",
    "autoprefixer": "^10.4.14",
    "core-js": "^3.33.1",
    "eslint": "^8.51.0",
    "eslint-plugin-vue": "^9.0.0",
    "json-sort-cli": "^3.1.5",
    "sass": "^1.62.1",
    "stylelint": "^14.16.0",
    "stylelint-value-no-unknown-custom-properties": "^5.0.0",
    "svgo": "^3.0.2",
    "vite": "^4.0.0",
    "vite-plugin-ejs": "^1.6.4",
    "vite-plugin-minify": "^1.5.2",
    "vite-plugin-node-polyfills": "^0.9.0",
    "vite-svg-loader": "^4.0.0",
    "vue-i18n-extract": "^2.0.7"
  },
  "overrides": {
    "@coinspace/cs-common": "github:CoinSpace/cs-common",
    "@coinspace/monero-core-js": "github:CoinSpace/monero-core-js"
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "eslintConfig": {
    "root": true,
    "ignorePatterns": [
      "/dist"
    ],
    "extends": [
      "plugin:vue/vue3-recommended",
      "plugin:@intlify/vue-i18n/recommended",
      "eslint:recommended",
      "coinspace"
    ],
    "rules": {
      "vue/attribute-hyphenation": [
        "error",
        "never"
      ],
      "vue/return-in-computed-property": "off",
      "vue/v-on-event-hyphenation": [
        "error",
        "never"
      ],
      "@intlify/vue-i18n/no-missing-keys": "off",
      "@intlify/vue-i18n/no-raw-text": [
        "error",
        {
          "ignorePattern": "^[+-0-9()]$",
          "ignoreText": [
            "*****",
            "·"
          ]
        }
      ]
    },
    "env": {
      "browser": true
    },
    "parserOptions": {
      "requireConfigFile": false,
      "sourceType": "module"
    },
    "overrides": [
      {
        "files": [
          "./src/views/Crypto/Exchange/*",
          "./src/views/Design/*",
          "./src/layouts/DesignLayout.vue"
        ],
        "rules": {
          "@intlify/vue-i18n/no-raw-text": "off"
        }
      }
    ]
  },
  "stylelint": {
    "extends": "stylelint-config-coinspace",
    "plugins": [
      "stylelint-value-no-unknown-custom-properties"
    ],
    "rules": {
      "csstools/value-no-unknown-custom-properties": [
        true,
        {
          "importFrom": "./src/assets/styles/variables.css"
        }
      ]
    }
  }
}
